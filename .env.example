# NEAR Intents 1-Click API key (server-side, required)
NEAR_ONECLICK_API_KEY=

# Helius RPC for Solana wallet balances (server-side proxy, never exposed to client)
HELIUS_API_KEY=

# MoonPay Ramps — fiat on-ramp widget (publishable key is safe for client-side)
NEXT_PUBLIC_MOONPAY_PUBLISHABLE_KEY=

# MoonPay secret key — server-side only, required for URL signing when walletAddress is set
MOONPAY_SECRET_KEY=
